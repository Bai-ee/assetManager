{
  "name": "moleboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scan": "tsx lib/scanner/cli.ts",
    "archive:scan": "tsx --env-file-if-exists=.env.local lib/archive/cli.ts",
    "typecheck": "tsc --noEmit",
    "test:archive": "TESTS=$(find lib/archive -name '*.test.ts' | sort) && test -n \"$TESTS\" && tsx --test $TESTS",
    "archive:worker": "tsx --env-file-if-exists=.env.local lib/archive/daemon.ts",
    "archive:analyzer": "tsx --env-file-if-exists=.env.local lib/discogs/analyzer-entry.ts",
    "archive:analyzer:dates": "tsx lib/archive/analyzer/backfill-dates.ts",
    "archive:source": "tsx --env-file-if-exists=.env.local lib/archive/source-cli.ts",
    "archive:twelvelabs-index": "tsx --env-file-if-exists=.env.local lib/archive/twelvelabs-index-cli.ts",
    "discogs:publish": "tsx --env-file-if-exists=.env.local lib/discogs/publish-cli.ts",
    "discogs:check": "node --experimental-strip-types --env-file-if-exists=.env.local lib/discogs/check-cli.ts",
    "discogs:doctor": "tsx --env-file-if-exists=.env.local lib/discogs/doctor-cli.ts",
    "discogs:ingest": "tsx --env-file-if-exists=.env.local lib/discogs/ingest-cli.ts",
    "test:discogs": "tsx --test lib/discogs/*.test.ts",
    "photolib:inspect": "tsx lib/photolib/inspect.ts"
  },
  "dependencies": {
    "@ardrive/turbo-sdk": "^1.29.0",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.3.0",
    "exiftool-vendored": "^39.1.1",
    "lucide-react": "^0.356.0",
    "next": "^14.2.0",
    "plist": "^5.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "class-variance-authority": "^0.7.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
